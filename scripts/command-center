#!/bin/bash
# Open Command Center in a new Terminal window
# Automatically detects project directory based on script location
# Usage: ./scripts/command-center [session-name]

SESSION=${1:-command_center}

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$( cd "$SCRIPT_DIR/.." && pwd )"

# Use osascript to open a new Terminal window and run the launcher
osascript - "$PROJECT_DIR" "$SESSION" << 'APPLESCRIPT'
on run argv
    set projectDir to item 1 of argv
    set sessionName to item 2 of argv

    tell application "Terminal"
        -- Create a new window
        set newWindow to (create window with default profile)

        -- Run the launch script in the new window
        do script "cd " & projectDir & " && ./scripts/launch-command-center.sh " & sessionName in newWindow

        -- Activate Terminal
        activate
    end tell
end run
APPLESCRIPT
